# Deployment environment: dev | prod.
# Drives the enforced OpenAI reasoning profile — dev = low effort / 4000 max output
# tokens, prod = high effort / 8000. Not overridable per-key; set this and nothing else.
# Defaults to dev, so prod deployments MUST inject ENVIRONMENT=prod explicitly.
ENVIRONMENT=dev
# RAG (Qdrant read path)
QDRANT_ENDPOINT=http://localhost:6333
QDRANT_API_KEY=dummy
GOOGLE_API_KEY=
PRODUCT_COLLECTION=cenlab
# LLM (vendored client — Anthropic + OpenAI)
# Default model for every agent. Models containing "claude" route to Anthropic;
# everything else routes to OpenAI.
AGENT_MODEL=gpt-5.4-mini
# Per-agent overrides — leave unset to inherit AGENT_MODEL.
TRIAGE_MODEL=gpt-5.4-mini
KNOWLEDGE_MODEL=gpt-5.6-luna
KNOWLEDGE_CONTEXTUALIZE_MODEL=gpt-5.4-mini
VERIFICATION_MODEL=gpt-5.4-mini
FLOW_MODEL=gpt-5.4-mini
GUARDRAIL_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Observability (Langfuse) — leave blank to disable tracing (no-op).
# Use Langfuse Cloud (https://cloud.langfuse.com) or a self-hosted instance.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Offline KB indexing only (scripts/index_kb.py via enterprise_llm_service) — not used at runtime
TOGETHERAI_API_KEY=dummy
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# DynamoDB
DYNAMODB_ENDPOINT_URL=http://localhost:8000
# True locally so DynamoDB Local gets tables created for you on startup.
# Set to False in prod: tables are provisioned ahead of time and the app's
# IAM user should not hold dynamodb:CreateTable.
DYNAMODB_AUTO_CREATE_TABLES=True
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=ap-southeast-1
# Attachment storage (S3). Uploaded screenshots go here and the conversation turn
# keeps only the key — a conversation is ONE DynamoDB item and DynamoDB caps items
# at 400KB, which base64 image bytes blow past almost immediately.
# Local dev points at LocalStack; unset it to hit real AWS.
S3_ENDPOINT_URL=http://localhost:4566
S3_BUCKET_ATTACHMENTS=elsa-agent-customer-support-local
# As with DynamoDB tables: True locally, False in prod where the bucket is
# provisioned ahead of time and the app's IAM user should not hold s3:CreateBucket.
S3_AUTO_CREATE_BUCKET=True
# Lifetime of the presigned URLs handed to the widget for displaying images.
S3_PRESIGN_EXPIRY_SECONDS=3600
# Rejected with 413 at the API boundary, before any S3 or LLM spend.
MAX_ATTACHMENT_BYTES=5242880
# Document images (S3, read-only): the screenshots and button glyphs extracted from the
# user guides, laid out as <prefix>/<application_slug>/imageNN.png so a key is derived
# straight from a chunk's metadata.application. Uploaded by scripts/upload_doc_images.py.
# A separate bucket from the attachments one: user uploads are private per-conversation
# data, these are shared assets. Whether an answer can show images is decided entirely by
# what is in this bucket — an un-uploaded document simply answers in text.
S3_BUCKET_DOC_IMAGES=elsa-enterprise-llm-service-local
DOC_IMAGES_PREFIX=doc_images
# How long the per-application file listing is cached in-process. Coarse on purpose: the
# bucket only changes when a document is re-ingested.
DOC_IMAGES_CACHE_SECONDS=600
# Ceiling on images per reply, applied after composition (screenshots win over icons).
MAX_REPLY_IMAGES=5
# Redis
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600
# Escalation
ZALO_CS_WEBHOOK_URL=
# CORS — comma-separated list of allowed origins for the UI
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Auth. JWT_SECRET signs every access token and has NO default — the server refuses to
# start without it. Use at least 32 random bytes (`openssl rand -base64 48`) and a
# different value per environment: anyone holding it can mint a token for any customer,
# including an admin one.
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
