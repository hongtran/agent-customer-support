# RAG (Qdrant read path)
QDRANT_ENDPOINT=http://localhost:6333
QDRANT_API_KEY=dummy
GOOGLE_API_KEY=
PRODUCT_COLLECTION=cenlab
# LLM (vendored client — Anthropic + OpenAI)
AGENT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Observability (Langfuse) — leave blank to disable tracing (no-op).
# Use Langfuse Cloud (https://cloud.langfuse.com) or a self-hosted instance.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Offline KB indexing only (scripts/index_kb.py via enterprise_llm_service) — not used at runtime
TOGETHERAI_API_KEY=dummy
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# DynamoDB
DYNAMODB_ENDPOINT_URL=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=ap-southeast-1
# Redis
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600
# Escalation
ZALO_CS_WEBHOOK_URL=
